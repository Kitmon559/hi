local function FarmCycle()
    local item = GetRandomSelectedItem()
    if not item then return false end
    
    SetStatus("🚀 К предмету: " .. item.Name, Color3.fromRGB(255, 220, 100))
    MoveToSmart(function() return GetItemPosition(item) end, 20)
    task.wait(0.2)
    
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return false end
    
    SetStatus("✋ Берём: " .. item.Name, Color3.fromRGB(255, 180, 100))
    for i = 1, 4 do PressE(); task.wait(0.15) end
    task.wait(0.5)
    
    local chosenHoleName = "?"
    SetStatus("🕳️ Ищем дырку...", Color3.fromRGB(150, 255, 150))
    
    MoveToSmart(function()
        local hole, _ = GetNearestHoleFromCurrentPos()
        if not hole then return nil end
        if hole.Name ~= chosenHoleName then
            chosenHoleName = hole.Name
            SetStatus("🕳️ К дырке: " .. hole.Name, Color3.fromRGB(150, 255, 150))
        end
        return GetItemPosition(hole)
    end, 25)
    
    local st = tonumber(StandBox.Text) or 1.5
    SetStatus("⏱️ Стоим " .. st .. "с...", Color3.fromRGB(200, 200, 255))
    local el = 0
    while el < st do task.wait(0.1); el = el + 0.1 end
    
    SetStatus("🖱️ Выброс...", Color3.fromRGB(255, 180, 100))
    PressLeftClick(); task.wait(0.4); PressLeftClick(); task.wait(0.2)
    return true
end

