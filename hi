local function NormalizeName(name)
    return name:gsub("%s*%d+$", ""):gsub("%s+$", ""):lower():gsub("%s+", "")
end

local function GetItemRarity(itemName)
    if ItemRarityMap[itemName] then return ItemRarityMap[itemName] end
    local n = NormalizeName(itemName)
    for name, r in pairs(ItemRarityMap) do
        if NormalizeName(name) == n then return r end
    end
    return "Common"
end

