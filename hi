local function StopMove()
    MoveActive = false
    MoveTarget = nil
    if moveConnection then moveConnection:Disconnect(); moveConnection = nil end
end

local function MoveToSmart(targetGetter, timeout)
    timeout = timeout or 20
    StopMove()
    MoveActive = true
    local startT = tick()
    
    moveConnection = RunService.Heartbeat:Connect(function(dt)
        if not MoveActive then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        hrp.AssemblyLinearVelocity = Vector3.new(0,0,0)
        hrp.AssemblyAngularVelocity = Vector3.new(0,0,0)
        hrp.Velocity = Vector3.new(0,0,0)
        
        local target = targetGetter()
        if not target then return end
        MoveTarget = target
        
        local cur = hrp.Position
        local diff = MoveTarget - cur
        local dist = diff.Magnitude
        
        if dist < 2 then
            hrp.CFrame = CFrame.new(MoveTarget)
            MoveActive = false
            return
        end
        
        local step = CurrentSpeed * dt
        if step > dist then step = dist end
        hrp.CFrame = CFrame.new(cur + diff.Unit * step)
    end)
    
    while MoveActive and (tick() - startT) < timeout do task.wait(0.05) end
    StopMove()
end

