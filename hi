--// ==================== 🔍 HOLEITEMS (ФИКС КЭША) ====================
local HoleItemsMode = nil
local HoleItemsInstance = nil
local HoleItemsAttrName = nil
local HoleItemsPath = nil

local function FindHoleItems()
    local lp = LocalPlayer
    if not lp then return nil end
    
    -- 🎯 Атрибут "HoleItems" (большая H) — берём ПЕРВЫМ
    if lp:GetAttribute("HoleItems") ~= nil then
        HoleItemsMode = "attribute"
        HoleItemsAttrName = "HoleItems"
        HoleItemsPath = "Attribute 'HoleItems'"
        return "ATTR"
    end
    
    -- Атрибут "holeitems" (маленькие)
    if lp:GetAttribute("holeitems") ~= nil then
        HoleItemsMode = "attribute"
        HoleItemsAttrName = "holeitems"
        HoleItemsPath = "Attribute 'holeitems'"
        return "ATTR"
    end
    
    -- Instance HoleItems
    local v = lp:FindFirstChild("HoleItems")
    if v and v:IsA("ValueBase") then
        HoleItemsMode = "instance"
        HoleItemsInstance = v
        HoleItemsPath = "LocalPlayer.HoleItems"
        return v
    end
    
    -- Instance holeitems
    v = lp:FindFirstChild("holeitems")
    if v and v:IsA("ValueBase") then
        HoleItemsMode = "instance"
        HoleItemsInstance = v
        HoleItemsPath = "LocalPlayer.holeitems"
        return v
    end
    
    -- leaderstats
    local ls = lp:FindFirstChild("leaderstats")
    if ls then
        v = ls:FindFirstChild("HoleItems") or ls:FindFirstChild("holeitems")
        if v then
            HoleItemsMode = "instance"
            HoleItemsInstance = v
            HoleItemsPath = "LocalPlayer.leaderstats." .. v.Name
            return v
        end
    end
    
    return nil
end

FindHoleItems()

-- 🔥 ЧТЕНИЕ ВСЕГДА СВЕЖЕЕ (не кэшируется)
local function GetHoleItems()
    local lp = LocalPlayer
    if not lp then return 0 end
    
    -- Атрибут — читаем заново
    if HoleItemsMode == "attribute" and HoleItemsAttrName then
        return tonumber(lp:GetAttribute(HoleItemsAttrName)) or 0
    end
    
    -- Instance — читаем .Value
    if HoleItemsMode == "instance" and HoleItemsInstance then
        if not HoleItemsInstance.Parent then
            FindHoleItems()
            if HoleItemsMode == "attribute" and HoleItemsAttrName then
                return tonumber(lp:GetAttribute(HoleItemsAttrName)) or 0
            end
        end
        if HoleItemsInstance and HoleItemsInstance.Parent then
            local ok, val = pcall(function() return HoleItemsInstance.Value end)
            if ok and val ~= nil then return tonumber(val) or 0 end
        end
    end
    
    -- Переискиваем
    FindHoleItems()
    if HoleItemsMode == "attribute" and HoleItemsAttrName then
        return tonumber(lp:GetAttribute(HoleItemsAttrName)) or 0
    elseif HoleItemsMode == "instance" and HoleItemsInstance and HoleItemsInstance.Parent then
        local ok, val = pcall(function() return HoleItemsInstance.Value end)
        if ok and val ~= nil then return tonumber(val) or 0 end
    end
    
    return 0
end

