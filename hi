--// ==================== ХЕЛПЕРЫ ====================
local ItemButtons = {}

local function SetStatus(text, color)
    StatusLabel.Text = text
    StatusLabel.TextColor3 = color or Color3.fromRGB(150, 200, 255)
end

local function CountSelected()
    local c = 0
    for _ in pairs(SelectedItems) do c = c + 1 end
    return c
end

local function UpdateSelectedLabel()
    SetStatus("Выбрано: " .. CountSelected())
end

local function GetItemPosition(item)
    if not item or not item.Parent then return nil end
    if item:IsA("BasePart") then return item.Position
    elseif item:IsA("Model") then
        local ok, p = pcall(function() return item:GetPivot() end)
        if ok then return p.Position end
    end
    return nil
end

local function GetNearestHoleFrom(pos)
    local nearest, nd = nil, math.huge
    for _, hole in ipairs(HolesFolder:GetChildren()) do
        local p = GetItemPosition(hole)
        if p then
            local d = (pos - p).Magnitude
            if d < nd then nd = d; nearest = hole end
        end
    end
    return nearest, nd
end

local function GetNearestHoleFromCurrentPos()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    return GetNearestHoleFrom(hrp.Position)
end

local function GetRandomSelectedItem()
    local valid = {}
    for _, item in ipairs(TargetFolder:GetChildren()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local base = item.Name:gsub("%s*%d+$", ""):gsub("%s+$", "")
            if SelectedItems[base] then table.insert(valid, item) end
        end
    end
    if #valid == 0 then return nil end
    return valid[math.random(1, #valid)]
end

--// ==================== СПИСОК ====================
local function UpdateAllCounters()
    local counts = {}
    for _, item in ipairs(TargetFolder:GetChildren()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local base = item.Name:gsub("%s*%d+$", ""):gsub("%s+$", "")
            counts[base] = (counts[base] or 0) + 1
        end
    end
    for name, data in pairs(ItemButtons) do
        local count = counts[name] or 0
        if data.countLabel then
            data.countLabel.Text = "x" .. count
            if count == 0 then
                data.countLabel.TextColor3 = Color3.fromRGB(110, 110, 110)
                if data.nameLabel then data.nameLabel.TextColor3 = Color3.fromRGB(110, 110, 110) end
                if data.btn and not SelectedItems[name] then
                    data.btn.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
                end
            else
                if count <= 2 then data.countLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
                elseif count <= 5 then data.countLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
                else data.countLabel.TextColor3 = Color3.fromRGB(100, 255, 100) end
                if data.nameLabel then data.nameLabel.TextColor3 = Color3.fromRGB(220, 220, 220) end
                if data.btn and not SelectedItems[name] then
                    data.btn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
                end
            end
        end
    end
end

local function RefreshItemList()
    for _, c in ipairs(ItemListFrame:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
    ItemButtons = {}
    
    local counts = {}
    for _, item in ipairs(TargetFolder:GetChildren()) do
        if item:IsA("BasePart") or item:IsA("Model") then
            local base = item.Name:gsub("%s*%d+$", ""):gsub("%s+$", "")
            counts[base] = (counts[base] or 0) + 1
        end
    end
    
    local byRarity = {}
    for _, r in ipairs(RarityOrder) do byRarity[r] = {} end
    
    for rarityName, data in pairs(Rarities) do
        for _, itemName in ipairs(data.items) do
            table.insert(byRarity[rarityName], {
                name = itemName, displayName = itemName,
                count = counts[itemName] or 0, rarity = rarityName
            })
        end
    end
    
    local known = {}
    for _, data in pairs(Rarities) do
        for _, n in ipairs(data.items) do known[n:lower():gsub("%s+", "")] = true end
    end
    for baseName, count in pairs(counts) do
        if not known[baseName:lower():gsub("%s+", "")] then
            table.insert(byRarity["Common"], {
                name = baseName, displayName = baseName, count = count, rarity = "Common"
            })
        end
    end
    
    for _, rarityName in ipairs(RarityOrder) do
        local items = byRarity[rarityName]
        if not items or #items == 0 then continue end
        table.sort(items, function(a, b) return a.name:lower() < b.name:lower() end)
        
        local total = 0
        for _, it in ipairs(items) do total = total + it.count end
        
        local header = Instance.new("TextLabel")
        header.Size = UDim2.new(1, 0, 0, 20)
        header.BackgroundColor3 = GetRarityColor(rarityName):Lerp(Color3.new(0,0,0), 0.7)
        header.BorderSizePixel = 0
        header.Text = "  " .. rarityName:upper() .. " (" .. #items .. " видов / " .. total .. " шт)"
        header.TextColor3 = GetRarityColor(rarityName)
        header.TextSize = 11
        header.Font = Enum.Font.GothamBold
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.Parent = ItemListFrame
        Instance.new("UICorner", header).CornerRadius = UDim.new(0, 4)
        
        for _, data in ipairs(items) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 24)
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.BackgroundColor3 = data.count == 0 and Color3.fromRGB(28, 28, 32) or Color3.fromRGB(50, 50, 65)
            btn.Parent = ItemListFrame
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
            
            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(0, 4, 1, 0)
            bar.BackgroundColor3 = data.count == 0 and GetRarityColor(rarityName):Lerp(Color3.fromRGB(50,50,50), 0.7) or GetRarityColor(rarityName)
            bar.BorderSizePixel = 0
            bar.Parent = btn
            Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -60, 1, 0)
            nameLabel.Position = UDim2.new(0, 10, 0, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = "  " .. data.displayName
            nameLabel.TextColor3 = data.count == 0 and Color3.fromRGB(110,110,110) or Color3.fromRGB(220,220,220)
            nameLabel.TextSize = 12
            nameLabel.Font = Enum.Font.Gotham
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
            nameLabel.Parent = btn
            
            local countLabel = Instance.new("TextLabel")
            countLabel.Size = UDim2.new(0, 45, 1, 0)
            countLabel.Position = UDim2.new(1, -50, 0, 0)
            countLabel.BackgroundTransparency = 1
            countLabel.Text = "x" .. data.count
            countLabel.TextSize = 12
            countLabel.Font = Enum.Font.GothamBold
            countLabel.TextXAlignment = Enum.TextXAlignment.Right
            countLabel.Parent = btn
            
            if data.count == 0 then countLabel.TextColor3 = Color3.fromRGB(110, 110, 110)
            elseif data.count <= 2 then countLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            elseif data.count <= 5 then countLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
            else countLabel.TextColor3 = Color3.fromRGB(100, 255, 100) end
            
            ItemButtons[data.name] = {btn = btn, countLabel = countLabel, nameLabel = nameLabel, name = data.name}
            
            if SelectedItems[data.name] then
                btn.BackgroundColor3 = Color3.fromRGB(60, 130, 220)
            end
            
            btn.MouseButton1Click:Connect(function()
                if SelectedItems[data.name] then
                    SelectedItems[data.name] = nil
                    local c = tonumber(countLabel.Text:sub(2)) or 0
                    btn.BackgroundColor3 = c == 0 and Color3.fromRGB(28, 28, 32) or Color3.fromRGB(50, 50, 65)
                else
                    SelectedItems[data.name] = true
                    btn.BackgroundColor3 = Color3.fromRGB(60, 130, 220)
                end
                if not AutoFarm then UpdateSelectedLabel() end
                SaveSelectedItems()
            end)
        end
    end
    
    UpdateSelectedLabel()
end

